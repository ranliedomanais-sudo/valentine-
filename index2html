<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Be My Valentine 💘</title>

<style>
* { box-sizing: border-box; }

body {
    margin: 0;
    height: 100vh;
    background: linear-gradient(135deg, #ff9a9e, #fad0c4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Arial, sans-serif;
    overflow: hidden;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 25px;
    text-align: center;
    width: 92%;
    max-width: 380px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.25);
    animation: pop 0.6s ease;
    position: relative;
}

@keyframes pop {
    0% { transform: scale(0.85); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
}

h1 {
    color: #ff4d6d;
    font-size: 1.7em;
}

h2 {
    color: #ff758f;
    font-size: 1.1em;
}

p {
    font-size: 1em;
    color: #555;
    line-height: 1.45em;
}

img {
    width: 100%;
    border-radius: 18px;
    margin: 15px 0;
}

.buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 15px;
}

button {
    padding: 12px 25px;
    font-size: 1em;
    border: none;
    border-radius: 30px;
    cursor: pointer;
}

#yes {
    background: #ff4d6d;
    color: white;
}

#no {
    background: #eee;
    color: #333;
    position: fixed;
    pointer-events: none;
}

#muteBtn {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #ffb3c1;
    color: #333;
    padding: 6px 12px;
    font-size: 0.85em;
    border-radius: 20px;
}

.heart {
    position: fixed;
    font-size: 22px;
    animation: floatUp 3s linear forwards;
}

@keyframes floatUp {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(-120px); opacity: 0; }
}
</style>
</head>

<body>

<!-- BACKGROUND MUSIC -->
<audio id="music" loop>
    <source src="nothing.mp3" type="audio/mpeg">
</audio>

<div class="card" id="card">
    <button id="muteBtn">🔇</button>

    <h1>💘 Hi Angel Gwyneth D. Sanchez l 💘</h1>
    <h2>I have something important to ask 😳</h2>

    <img src="photo.jpg" alt="Us 🥰">

    <p>
        I thought about this very seriously  
        (like… Bruno Major playlist serious 🎶)  
        and I realized something:
        <br><br>
        I kinda don’t want Valentine’s Day
        unless it’s with **you** 💖
    </p>

    <div class="buttons">
        <button id="yes">Yes 💖</button>
        <button id="no">No 🙃</button>
    </div>
</div>

<script>
const noBtn = document.getElementById("no");
const yesBtn = document.getElementById("yes");
const card = document.getElementById("card");
const music = document.getElementById("music");
const muteBtn = document.getElementById("muteBtn");

let muted = true;

// Mobile-safe music start
document.body.addEventListener("click", () => {
    if (music.paused) music.play();
}, { once: true });

// Mute toggle
muteBtn.addEventListener("click", () => {
    muted = !muted;
    music.muted = muted;
    muteBtn.textContent = muted ? "🔇" : "🔊";
});

// NO BUTTON IMPOSSIBLE FOREVER
function teleportNo() {
    noBtn.style.left = Math.random() * window.innerWidth + "px";
    noBtn.style.top = Math.random() * window.innerHeight + "px";
}
setInterval(teleportNo, 500);
document.addEventListener("mousemove", teleportNo);
document.addEventListener("touchstart", teleportNo);

// Fake "Are you sure?" screen
yesBtn.addEventListener("click", () => {
    card.innerHTML = `
        <h1>😳 Are you sure??</h1>
        <p>
            Like…  
            *emotionally prepared* sure??  
            This includes:
            <br><br>
            • me liking you a lot  
            • random laughs  
            • food dates 🍟  
        </p>
        <div class="buttons">
            <button id="sureYes">Yes yes YES 💖</button>
        </div>
    `;

    document.getElementById("sureYes").addEventListener("click", finalYes);
});

function finalYes() {
    card.innerHTML = `
        <h1>🥰 YAYYYY 🥰</h1>
        <p>
            You’re officially my Valentine 💖  
            No takebacks. No refunds.  
            Just vibes, music, and us ✨
        </p>
    `;
    hearts();
}

function hearts() {
    setInterval(() => {
        const heart = document.createElement("div");
        heart.className = "heart";
        heart.textContent = "💖";
        heart.style.left = Math.random() * window.innerWidth + "px";
        heart.style.bottom = "0";
        document.body.appendChild(heart);
        setTimeout(() => heart.remove(), 3000);
    }, 250);
}
</script>

</body>
</html>
